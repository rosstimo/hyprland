#!/bin/bash

# Toggle hyprsunset between night and daylight screen temperatures.

ON_TEMP=4000
OFF_TEMP=6000

if ! command -v hyprsunset >/dev/null 2>&1; then
  command -v notify-send >/dev/null 2>&1 && notify-send "Nightlight" "Missing dependency: hyprsunset"
  exit 1
fi

# Ensure hyprsunset is running.
if ! pgrep -x hyprsunset >/dev/null; then
  setsid hyprsunset >/dev/null 2>&1 &
  sleep 0.5 # Give it time to register its control socket.
fi

# Query the current temperature.
current_temp=$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -1)

if [[ $current_temp == "$OFF_TEMP" ]]; then
  hyprctl hyprsunset temperature "$ON_TEMP"
  command -v notify-send >/dev/null 2>&1 && notify-send -u low "  Nightlight screen temperature"
else
  hyprctl hyprsunset identity
  command -v notify-send >/dev/null 2>&1 && notify-send -u low "  Daylight screen temperature"
fi

# Refresh an optional Waybar nightlight indicator.
pkill -RTMIN+9 waybar 2>/dev/null || true
