#!/bin/bash

# Toggle hypridle idle locking.

if pgrep -x hypridle >/dev/null; then
  pkill -x hypridle
  command -v notify-send >/dev/null 2>&1 && notify-send -u low "󱫖    Stop locking computer when idle"
else
  setsid hypridle >/dev/null 2>&1 &
  command -v notify-send >/dev/null 2>&1 && notify-send -u low "󱫖    Now locking computer when idle"
fi

pkill -RTMIN+9 waybar 2>/dev/null || true
