#!/bin/bash

# Print the current working directory of the active terminal window.
# Fall back to $HOME when the active process is not a shell with a readable
# working directory.

terminal_pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')
shell_pid=$(pgrep -P "$terminal_pid" 2>/dev/null | tail -n1)

if [[ -n $shell_pid ]]; then
  cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null)
  shell=$(readlink -f "/proc/$shell_pid/exe" 2>/dev/null)

  # Check if $shell is a valid shell and $cwd is a directory.
  if grep -qsFx "$shell" /etc/shells && [[ -d $cwd ]]; then
    printf '%s\n' "$cwd"
    exit 0
  fi
fi

printf '%s\n' "$HOME"
